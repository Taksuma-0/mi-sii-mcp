{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Taksuma-0/mi-sii-mcp",
  "title": "mi-sii-mcp",
  "description": "Servidor MCP para el SII de Chile: IVA, F29, F22 y boletas de honorarios. Solo lectura y local.",
  "version": "0.1.0",
  "websiteUrl": "https://taksuma-0.github.io/mi-sii-mcp/",
  "repository": {
    "url": "https://github.com/Taksuma-0/mi-sii-mcp",
    "source": "github",
    "id": "1435920355"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "mi-sii-mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "MI_SII_MCP_HOME",
          "description": "Carpeta de datos (por defecto ~/.mi-sii-mcp)",
          "isRequired": false,
          "format": "filepath"
        }
      ]
    }
  ]
}
